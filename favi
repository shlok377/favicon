#!/usr/bin/env bash
# ==============================================================================
# Favi — Application Launcher & Lifecycle Manager
# ==============================================================================
set -euo pipefail

# 1. Dynamic Root Directory Resolution (Relocatable)
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$APP_DIR/backend"
LOGS_DIR="$APP_DIR/logs"
RUNTIME_DIR="$APP_DIR/.runtime"
VENV_DIR="$APP_DIR/.venv"
PID_FILE="$APP_DIR/.favi.pid"
PORT_FILE="$APP_DIR/.favi.port"
INSTALL_PATH_FILE="$APP_DIR/.install_path"
DEFAULT_PORT=1937

mkdir -p "$LOGS_DIR"

# ------------------------------------------------------------------------------
# Helpers & UI
# ------------------------------------------------------------------------------
log() {
    echo -e "\033[1;34m[Favi]\033[0m $*"
}

log_success() {
    echo -e "\033[1;32m[Favi] ✔\033[0m $*"
}

log_warn() {
    echo -e "\033[1;33m[Favi] ⚠\033[0m $*"
}

log_error() {
    echo -e "\033[1;31m[Favi] ✖\033[0m $*" >&2
}

# ------------------------------------------------------------------------------
# Self-Healing Relocation Engine
# ------------------------------------------------------------------------------
check_relocation() {
    if [ -f "$INSTALL_PATH_FILE" ]; then
        LAST_PATH="$(cat "$INSTALL_PATH_FILE" 2>/dev/null || echo "")"
        if [ -n "$LAST_PATH" ] && [ "$LAST_PATH" != "$APP_DIR" ]; then
            log_warn "Application folder relocation detected!"
            log_warn "Previous: $LAST_PATH"
            log_warn "Current:  $APP_DIR"
            log "Self-healing Python environment and paths..."
            # Recreate or repair venv if moved
            if [ -d "$VENV_DIR" ]; then
                rm -rf "$VENV_DIR"
            fi
            ensure_runtime
            update_desktop_shortcuts
            echo "$APP_DIR" > "$INSTALL_PATH_FILE"
            log_success "Self-healing completed successfully!"
        fi
    else
        echo "$APP_DIR" > "$INSTALL_PATH_FILE"
    fi
}

update_desktop_shortcuts() {
    # If a desktop shortcut was previously created, refresh its Exec and Icon paths
    DESKTOP_ENTRY="$HOME/Desktop/Favi.desktop"
    APPLICATIONS_ENTRY="$HOME/.local/share/applications/favi.desktop"
    
    for SHORTCUT in "$DESKTOP_ENTRY" "$APPLICATIONS_ENTRY"; do
        if [ -f "$SHORTCUT" ]; then
            sed -i "s|Exec=.*|Exec=\"$APP_DIR/favi\" start|g" "$SHORTCUT" 2>/dev/null || true
            sed -i "s|Path=.*|Path=$APP_DIR|g" "$SHORTCUT" 2>/dev/null || true
            sed -i "s|Icon=.*|Icon=$APP_DIR/frontend/dist/favi.png|g" "$SHORTCUT" 2>/dev/null || true
        fi
    done
}

cmd_setup_shortcuts() {
    log "Configuring native desktop shortcuts and application menu entries..."
    local ICON_PATH="$APP_DIR/frontend/dist/favi.png"
    if [ ! -f "$ICON_PATH" ]; then
        ICON_PATH="$APP_DIR/favi.png"
    fi

    local OS_NAME
    OS_NAME="$(uname -s)"

    if [ "$OS_NAME" = "Linux" ]; then
        local APPS_DIR="$HOME/.local/share/applications"
        local DESKTOP_DIR="$HOME/Desktop"
        mkdir -p "$APPS_DIR"

        local DESKTOP_CONTENT="[Desktop Entry]
Version=1.0
Type=Application
Name=Favi
Comment=Favicon & Social Asset Generator
Exec=\"$APP_DIR/favi\" start
Icon=$ICON_PATH
Path=$APP_DIR
Terminal=false
StartupWMClass=google-chrome
Categories=Development;Graphics;Utility;
"
        echo "$DESKTOP_CONTENT" > "$APPS_DIR/favi.desktop"
        chmod +x "$APPS_DIR/favi.desktop"
        if command -v update-desktop-database &>/dev/null; then
            update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
        fi
        log_success "Registered desktop application in $APPS_DIR/favi.desktop"

        if [ -d "$DESKTOP_DIR" ] || [ -f "$DESKTOP_DIR" ]; then
            echo "$DESKTOP_CONTENT" > "$DESKTOP_DIR/Favi.desktop"
            chmod +x "$DESKTOP_DIR/Favi.desktop"
            if command -v gio &>/dev/null; then
                gio set "$DESKTOP_DIR/Favi.desktop" metadata::trusted true >/dev/null 2>&1 || true
            fi
            log_success "Created desktop shortcut at $DESKTOP_DIR/Favi.desktop"
        fi

    elif [ "$OS_NAME" = "Darwin" ]; then
        local DESKTOP_DIR="$HOME/Desktop"
        if [ -d "$DESKTOP_DIR" ]; then
            local COMMAND_FILE="$DESKTOP_DIR/Favi.command"
            cat <<EOF > "$COMMAND_FILE"
#!/usr/bin/env bash
cd "$APP_DIR" && ./favi start
EOF
            chmod +x "$COMMAND_FILE"
            log_success "Created macOS desktop launcher at $COMMAND_FILE"
        fi
    fi
}


# ------------------------------------------------------------------------------
# Runtime & Dependency Provisioning (Zero-Sudo with uv)
# ------------------------------------------------------------------------------
find_uv() {
    if [ -x "$RUNTIME_DIR/bin/uv" ]; then
        echo "$RUNTIME_DIR/bin/uv"
    elif [ -x "$RUNTIME_DIR/uv" ]; then
        echo "$RUNTIME_DIR/uv"
    elif command -v uv &>/dev/null; then
        command -v uv
    else
        echo ""
    fi
}

install_uv() {
    log "Provisioning portable, zero-sudo Python package manager (uv)..."
    mkdir -p "$RUNTIME_DIR"
    if curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$RUNTIME_DIR" sh >/dev/null 2>&1; then
        log_success "uv runtime installed cleanly in user-space."
    else
        log_warn "uv download failed. Falling back to host Python environment."
    fi
}

ensure_runtime() {
    if [ -f "$VENV_DIR/bin/python" ] && [ -f "$VENV_DIR/bin/uvicorn" ]; then
        return 0
    fi

    # Check if backend/.venv exists from previous setup
    if [ -f "$BACKEND_DIR/.venv/bin/python" ] && [ -f "$BACKEND_DIR/.venv/bin/uvicorn" ]; then
        if [ ! -d "$VENV_DIR" ]; then
            ln -s "$BACKEND_DIR/.venv" "$VENV_DIR" 2>/dev/null || cp -r "$BACKEND_DIR/.venv" "$VENV_DIR"
        fi
        return 0
    fi

    log "Setting up isolated Python environment..."
    UV_BIN="$(find_uv)"
    if [ -z "$UV_BIN" ]; then
        install_uv
        UV_BIN="$(find_uv)"
    fi

    if [ -n "$UV_BIN" ] && [ -x "$UV_BIN" ]; then
        log "Creating virtual environment with uv..."
        "$UV_BIN" venv "$VENV_DIR" --python 3.12 2>/dev/null || "$UV_BIN" venv "$VENV_DIR"
        log "Installing dependencies with uv..."
        "$UV_BIN" pip install -r "$BACKEND_DIR/requirements.txt" --python "$VENV_DIR/bin/python"
    elif command -v python3 &>/dev/null; then
        log "Using host python3 to initialize virtual environment..."
        python3 -m venv "$VENV_DIR"
        "$VENV_DIR/bin/pip" install --upgrade pip >/dev/null 2>&1 || true
        "$VENV_DIR/bin/pip" install -r "$BACKEND_DIR/requirements.txt"
    else
        log_error "No Python runtime or uv available. Please install Python 3."
        exit 1
    fi
    echo "$APP_DIR" > "$INSTALL_PATH_FILE"
    log_success "Python runtime ready."
}

# ------------------------------------------------------------------------------
# Port & Instance Management
# ------------------------------------------------------------------------------
is_port_in_use() {
    local port="$1"
    if command -v lsof &>/dev/null; then
        lsof -iTCP:"$port" -sTCP:LISTEN -n -P >/dev/null 2>&1
    elif command -v ss &>/dev/null; then
        ss -lnt | grep -q ":$port "
    elif command -v netstat &>/dev/null; then
        netstat -lnt | grep -q ":$port "
    else
        # Fallback test with python or curl
        curl -s "http://127.0.0.1:$port" >/dev/null 2>&1 || return 1
        return 0
    fi
}

check_favi_healthy() {
    local port="$1"
    local res
    res="$(curl -s --max-time 1 "http://127.0.0.1:$port/api/health" 2>/dev/null || echo "")"
    if [[ "$res" == *"healthy"* ]] && [[ "$res" == *"favicon-generator-api"* ]]; then
        return 0
    fi
    return 1
}

resolve_port() {
    local port="$DEFAULT_PORT"
    if check_favi_healthy "$port"; then
        echo "$port"
        return 0
    fi

    if is_port_in_use "$port"; then
        log_warn "Port $port is in use by another application. Trying fallback port $((port + 1))..."
        port=$((port + 1))
        while is_port_in_use "$port"; do
            if check_favi_healthy "$port"; then
                echo "$port"
                return 0
            fi
            port=$((port + 1))
        done
    fi
    echo "$port"
}

# ------------------------------------------------------------------------------
# Browser Launcher (--app mode)
# ------------------------------------------------------------------------------
launch_browser_window() {
    local port="$1"
    local url="http://localhost:$port"

    # Search for Chromium-based browsers for borderless app window
    local CHROMIUM_BIN=""
    for bin in google-chrome google-chrome-stable chromium chromium-browser brave-browser brave microsoft-edge msedge; do
        if command -v "$bin" &>/dev/null; then
            CHROMIUM_BIN="$(command -v "$bin")"
            break
        fi
    done

    # macOS application paths
    if [ -z "$CHROMIUM_BIN" ] && [ "$(uname -s)" = "Darwin" ]; then
        if [ -d "/Applications/Google Chrome.app" ]; then
            CHROMIUM_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
        elif [ -d "/Applications/Brave Browser.app" ]; then
            CHROMIUM_BIN="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
        elif [ -d "/Applications/Microsoft Edge.app" ]; then
            CHROMIUM_BIN="/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
        fi
    fi

    if [ -n "$CHROMIUM_BIN" ]; then
        log "Opening Favi in native app window mode..."
        "$CHROMIUM_BIN" --app="$url" >/dev/null 2>&1 &
    elif command -v xdg-open &>/dev/null; then
        xdg-open "$url" >/dev/null 2>&1 &
    elif command -v open &>/dev/null; then
        open "$url" >/dev/null 2>&1 &
    else
        log "Favi is ready at $url (open this URL in your browser)"
    fi
}

# ------------------------------------------------------------------------------
# Lifecycle Commands
# ------------------------------------------------------------------------------
cmd_start() {
    local no_browser=false
    for arg in "$@"; do
        if [ "$arg" == "--no-browser" ]; then
            no_browser=true
        fi
    done

    check_relocation
    ensure_runtime

    # Automatically set up desktop shortcuts if not yet created
    if [ ! -f "$HOME/.local/share/applications/favi.desktop" ] && [ ! -f "$HOME/Desktop/Favi.desktop" ]; then
        cmd_setup_shortcuts >/dev/null 2>&1 || true
    fi

    # Check if already running
    if [ -f "$PID_FILE" ]; then
        local old_pid
        old_pid="$(cat "$PID_FILE" 2>/dev/null || echo "")"
        local old_port
        old_port="$(cat "$PORT_FILE" 2>/dev/null || echo "$DEFAULT_PORT")"
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            if check_favi_healthy "$old_port"; then
                log_success "Favi is already running on port $old_port (PID: $old_pid)."
                if [ "$no_browser" = false ]; then
                    launch_browser_window "$old_port"
                fi
                return 0
            fi
        fi
        rm -f "$PID_FILE"
    fi

    local port
    port="$(resolve_port)"
    if check_favi_healthy "$port"; then
        log_success "Favi is already running on port $port."
        if [ "$no_browser" = false ]; then
            launch_browser_window "$port"
        fi
        return 0
    fi

    log "Starting Favi backend server on port $port..."
    export FAVI_PORT="$port"
    export FRONTEND_DIST_DIR="$APP_DIR/frontend/dist"

    nohup "$VENV_DIR/bin/python" -m uvicorn app.main:app \
        --app-dir "$BACKEND_DIR" \
        --host 127.0.0.1 \
        --port "$port" \
        >> "$LOGS_DIR/app.log" 2>&1 &
    
    local pid=$!
    echo "$pid" > "$PID_FILE"
    echo "$port" > "$PORT_FILE"

    # Wait for server to become healthy
    local attempts=0
    local max_attempts=30
    local healthy=false
    while [ "$attempts" -lt "$max_attempts" ]; do
        if check_favi_healthy "$port"; then
            healthy=true
            break
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            log_error "Server process terminated unexpectedly. Check $LOGS_DIR/app.log for details."
            rm -f "$PID_FILE" "$PORT_FILE"
            return 1
        fi
        sleep 0.2
        attempts=$((attempts + 1))
    done

    if [ "$healthy" = true ]; then
        log_success "Favi is live at http://localhost:$port (PID: $pid)"
        if [ "$no_browser" = false ]; then
            launch_browser_window "$port"
        fi
    else
        log_error "Server failed to respond within 6 seconds. Check $LOGS_DIR/app.log."
        return 1
    fi
}

cmd_stop() {
    if [ ! -f "$PID_FILE" ]; then
        log "Favi is not running."
        return 0
    fi

    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || echo "")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        log "Stopping Favi server (PID: $pid)..."
        kill -15 "$pid" 2>/dev/null || true
        local waited=0
        while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 15 ]; do
            sleep 0.2
            waited=$((waited + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
        log_success "Favi server stopped."
    else
        log "No active server process found with PID $pid."
    fi
    rm -f "$PID_FILE" "$PORT_FILE"
}

cmd_status() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(cat "$PID_FILE" 2>/dev/null || echo "")"
        local port
        port="$(cat "$PORT_FILE" 2>/dev/null || echo "$DEFAULT_PORT")"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            if check_favi_healthy "$port"; then
                echo "Status: Running"
                echo "PID:    $pid"
                echo "Port:   $port"
                echo "URL:    http://localhost:$port"
                return 0
            else
                echo "Status: Degraded (PID $pid alive, but health check failed)"
                return 1
            fi
        fi
    fi
    echo "Status: Stopped"
    return 0
}

cmd_logs() {
    if [ -f "$LOGS_DIR/app.log" ]; then
        tail -n 50 -f "$LOGS_DIR/app.log"
    else
        log "No logs found at $LOGS_DIR/app.log"
    fi
}

cmd_run() {
    # Foreground execution
    check_relocation
    ensure_runtime
    export FAVI_PORT="$DEFAULT_PORT"
    export FRONTEND_DIST_DIR="$APP_DIR/frontend/dist"
    exec "$VENV_DIR/bin/python" -m uvicorn app.main:app \
        --app-dir "$BACKEND_DIR" \
        --host 127.0.0.1 \
        --port "$DEFAULT_PORT"
}

# ------------------------------------------------------------------------------
# Dispatcher
# ------------------------------------------------------------------------------
ACTION="${1:-start}"
case "$ACTION" in
    start|run-window)
        shift 2>/dev/null || true
        cmd_start "$@"
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_stop
        shift 2>/dev/null || true
        cmd_start "$@"
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs
        ;;
    run)
        cmd_run
        ;;
    setup-shortcuts|create-shortcuts)
        cmd_setup_shortcuts
        ;;
    setup-runtime|ensure-runtime)
        ensure_runtime
        ;;
    help|--help|-h)
        echo "Usage: $0 {start|stop|restart|status|logs|run|setup-shortcuts} [options]"
        echo ""
        echo "Commands:"
        echo "  start            Launch Favi background daemon and open app window"
        echo "  stop             Terminate background server daemon"
        echo "  restart          Restart the background server daemon"
        echo "  status           Check current server health, PID, and port"
        echo "  logs             Tail the latest server logs"
        echo "  run              Run server in foreground for debugging"
        echo "  setup-shortcuts  Create desktop and application menu shortcuts"
        echo ""
        echo "Options:"
        echo "  --no-browser    Skip opening the browser window on start"
        ;;
    *)
        cmd_start "$@"
        ;;
esac
